@model GestionTareas.Models.Tarea

<h1>Eliminar Tarea</h1>

<div class="alert alert-danger">
    ⚠️ ¿Estás seguro de eliminar esta tarea?
    <strong>Esta acción no se puede deshacer.</strong>
</div>

<div>
    <h4>Tarea: @Model.Titulo</h4>
    <dl class="row">
        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@(Model.Completada ? "Completada" : "Pendiente")</dd>

        <dt class="col-sm-2">Creada</dt>
        <dd class="col-sm-10">@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            🗑️ Sí, Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            ❌ Cancelar
        </a>
    </form>
</div>