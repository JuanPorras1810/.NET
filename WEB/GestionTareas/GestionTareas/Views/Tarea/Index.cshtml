@model IEnumerable<GestionTareas.Models.Tarea>

<h1>Mis Tareas</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Tarea</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@(item.Completada ? "Completada" : "Pendiente")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>