@model GestorEmpleadosApp.Models.Empleado

@{
    ViewData["Title"] = "Eliminar Empleado";
}

<h2>¿Estás seguro de que deseas eliminar este empleado?</h2>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre Completo</dt>
        <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Fecha de Contratación</dt>
        <dd class="col-sm-9">@Model.FechaContratacion?.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Salario</dt>
        <dd class="col-sm-9">@Model.Salario.ToString("C")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>