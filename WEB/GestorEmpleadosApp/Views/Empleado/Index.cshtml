@model IEnumerable<GestorEmpleadosApp.Models.Empleado>
@{
    ViewData["Title"] = "Lista de Empleados";
}

<h2>Lista de Empleados</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Empleado</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre Completo</th>
            <th>Email</th>
            <th>Fecha Contratación</th>
            <th>Salario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre @item.Apellido</td>
                <td>@item.Email</td>
                <td>@item.FechaContratacion?.ToString("dd/MM/yyyy")</td>
                <td>@item.Salario.ToString("C")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>