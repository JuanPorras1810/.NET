@model IEnumerable<BibliotecaApp.Models.Libro>

<h1>Lista de Libros</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Libro</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>ISBN</th>
            <th>Año</th>
            <th>Autor</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Titulo</td>
            <td>@item.ISBN</td>
            <td>@item.AnioPublicacion</td>
            <td>@(item.Autor?.Nombre ?? "Sin autor")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>