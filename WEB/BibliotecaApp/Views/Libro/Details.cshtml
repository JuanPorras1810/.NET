@model BibliotecaApp.Models.Libro

<h1>Detalles del Libro</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Titulo</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>

        <dt class="col-sm-2">ISBN</dt>
        <dd class="col-sm-10">@Model.ISBN</dd>

        <dt class="col-sm-2">Año de Publicación</dt>
        <dd class="col-sm-10">@Model.AnioPublicacion</dd>

        <dt class="col-sm-2">Autor</dt>
        <dd class="col-sm-10">
            @(Model.Autor?.Nombre ?? "Sin autor asignado")
        </dd>
    </dl>
</div>

<div class="mt-4 mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
