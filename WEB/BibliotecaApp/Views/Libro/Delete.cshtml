@model BibliotecaApp.ViewModels.LibroViewModels.LIbroIndexViewModel

@{
    ViewData["Title"] = "Eliminar Libro";
}

<h2>¿Estás seguro de que deseas eliminar este libro?</h2>

<div class="alert alert-danger" role="alert">
    <strong>⚠️ Advertencia:</strong> Esta acción no se puede deshacer.
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.ISBN</dd>

        <dt class="col-sm-3">Año Publicación</dt>
        <dd class="col-sm-9">@Model.AnioPublicacion</dd>

        <dt class="col-sm-3">Autor</dt>
        <dd class="col-sm-9">@(Model.NombreAutor)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
