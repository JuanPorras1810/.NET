@model IEnumerable<BibliotecaApp.Models.Prestamo>

<h1>Lista de Prestamos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Prestamo</a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>Nombre Usuario</th>
            <th>Fecha Prestamo</th>
            <th>Fecha Devolucion</th>
            <th>Libro</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreUsuario</td>
                <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                <td>@(item.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                <td>@item.Libro?.Titulo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
