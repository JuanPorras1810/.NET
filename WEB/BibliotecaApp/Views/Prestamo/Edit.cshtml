@model BibliotecaApp.Models.Prestamo

<h1>Editar Prestamo</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="NombreUsuario" class="control-label"></label>
                <input asp-for="NombreUsuario" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="LibroId" class="control-label"></label>
                <select asp-for="LibroId" class="form-control" asp-items="ViewBag.Libros" disabled></select>
                <input type="hidden" asp-for="LibroId"/>
            </div>

            <div class="form-group">
                <label asp-for="FechaPrestamo" class="control-label"></label>
                <input asp-for="FechaPrestamo" class="form-control" type="date" readonly />
            </div>

            <div class="form-group">
                <label asp-for="FechaDevolucion" class="control-label"></label>
                @if (Model.FechaDevolucion != null)
                {
                    <input asp-for="FechaDevolucion" class="form-control" type="date" readonly />
                    }
                else
                {
                    <div class="input-group">
                        <input asp-for="FechaDevolucion" id="fechaDevolucionInput" class="form-control" type="date" readonly />
                        <button type="button" class="btn btn-outline-success" onclick="fechaDevolucionInput.valueAsDate = new Date()">
                            Marcar Devolución
                        </button>
                    </div>

                }
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar Cambios" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

