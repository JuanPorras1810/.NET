@model BibliotecaApp.Models.Prestamo

<h1>Detalles del Prestamo</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre Usuario</dt>
        <dd class="col-sm-10">@Model.NombreUsuario</dd>

        <dt class="col-sm-2">Fecha Prestamo</dt>
        <dd class="col-sm-10">@Model.FechaPrestamo.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Fecha Devolucion</dt>
        <dd class="col-sm-10">@(Model.FechaDevolucion?.ToString("dd/MM/yyyy") ?? "Pendiente")</dd>

        <dt class="col-sm-2">Libro</dt>
        <dd class="col-sm-10">@Model.Libro?.Titulo</dd>
    </dl>
</div>

<div class="mt-4 mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>