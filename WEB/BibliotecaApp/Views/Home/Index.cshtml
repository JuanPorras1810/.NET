@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border text-center">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-primary">Sistema de Gestión de Biblioteca</h1>
        <p class="col-md-10 fs-5 mx-auto text-muted">
            Bienvenido al panel principal. Desde aquí puedes administrar el catálogo de libros,
            el registro de autores y el control de préstamos de manera rápida y sencilla.
        </p>
    </div>
</div>

<div class="row g-4 mt-2">
    <!-- Tarjeta Libros -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <span class="fs-1 text-primary">📚</span>
                </div>
                <h4 class="card-title fw-bold">Libros</h4>
                <p class="card-text text-muted mb-0">
                    Consulta, añade o edita los libros disponibles en el sistema de la biblioteca.
                </p>
            </div>
        </div>
    </div>

    <!-- Tarjeta Autores -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <span class="fs-1 text-success">✍️</span>
                </div>
                <h4 class="card-title fw-bold">Autores</h4>
                <p class="card-text text-muted mb-0">
                    Administra los datos de los autores registrados y sus respectivas publicaciones.
                </p>
            </div>
        </div>
    </div>

    <!-- Tarjeta Préstamos -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <span class="fs-1 text-warning">📋</span>
                </div>
                <h4 class="card-title fw-bold">Préstamos</h4>
                <p class="card-text text-muted mb-0">
                    Lleva el control de las entregas, devoluciones pendientes y estados de préstamos.
                </p>
            </div>
        </div>
    </div>
</div>