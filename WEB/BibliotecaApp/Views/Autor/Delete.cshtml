@model BibliotecaApp.ViewModels.AutorViewModels.AutorIndexViewModel

@{
    ViewData["Title"] = "Eliminar Autor";
}

<h2>¿Estás seguro de que deseas eliminar este autor?</h2>

<div class="alert alert-danger" role="alert">
    <strong>⚠️ Advertencia:</strong> Esta acción no se puede deshacer.
    @if (Model.TotalLibros > 0)
    {
        <span>También se eliminarán <strong>@Model.TotalLibros libro(s)</strong> asociados.</span>
    }
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Nacionalidad</dt>
        <dd class="col-sm-9">@Model.Nacionalidad</dd>

        <dt class="col-sm-3">Fecha de Nacimiento</dt>
        <dd class="col-sm-9">
            @(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrada")
        </dd>

        <dt class="col-sm-3">Total de Libros</dt>
        <dd class="col-sm-9">
            <span class="badge bg-info fs-6">@Model.TotalLibros</span>
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>