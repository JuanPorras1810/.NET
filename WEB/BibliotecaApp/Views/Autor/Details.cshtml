@model BibliotecaApp.Models.Autor


<h1>Detalles del Autor</h1>


<div>

    <h4>Autor</h4>

    <hr />

    <dl class="row">

        <dt class="col-sm-2">Nombre</dt>

        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Nacionalidad</dt>

        <dd class="col-sm-10">@Model.Nacionalidad</dd>

        <dt class="col-sm-2">Fecha Nacimiento</dt>

        <dd class="col-sm-10">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>

    </dl>

</div>


<h3>Libros de este Autor</h3>

<table class="table">

    <thead>

        <tr>

            <th>Título</th>

            <th>ISBN</th>

            <th>Año</th>

        </tr>

    </thead>

    <tbody>

        @if (Model.Libros != null && Model.Libros.Any())

        {

            @foreach (var libro in Model.Libros)

            {

                <tr>

                    <td>@libro.Titulo</td>

                    <td>@libro.ISBN</td>

                    <td>@libro.AnioPublicacion</td>

                </tr>

            }

        }

        else

        {

            <tr>

                <td colspan="3">Este autor no tiene libros registrados</td>

            </tr>

        }

    </tbody>

</table>