@model IEnumerable<BibliotecaApp.Models.Autor>

<h1>Lista de Autores</h1>

<form asp-action="Index" method="get">
    <div class="input-group">
        <input name="buscar" class="form-control" placeholder="Buscar por nombre..." />
        <input type="submit" value="Buscar" class="control-label" />
    </div>
</form>


<p>
    <a asp-action="Create" class="btn btn-primary mt-3">Nuevo Autor </a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Nacionalidad</th>
            <th>Fecha Nacimiento</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Nacionalidad</td>
                <td>@item.FechaNacimiento?.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
