@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Eliminar Rol";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <h3 class="text-danger">¿Estás seguro de que deseas eliminar este rol?</h3>
    <hr />
    <div>
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Nombre del Rol</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.Name</span></dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
        </form>
    </div>
</div>